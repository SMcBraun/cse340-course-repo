<%- include('partials/header') %>

<!--
====================================================================
FILE: src/views/projects.ejs
PURPOSE:
View template that displays the collection of upcoming service projects, 
providing two-way navigation links to both individual project details 
and partner organization profiles.

PLAIN ENGLISH:
Loop over every upcoming project supplied by our controller and generate 
an HTML list item for each one, linking both the title and the sponsor.

LOGIC:
Runs an inline JavaScript Array.prototype.forEach loop through the 'projects' array.
Dynamically builds route parameter URLs (/project/:id and /organization/:id).

WHY WE NEED IT:
Provides central navigation between parent charities and child projects.

LEARNING GAP:
The view does not limit records to five. The SQL query (LIMIT 5) handles 
data slicing at the database layer before passing it down.
====================================================================
-->

<main>
    <h1><%= title %></h1>

    <p>Here are our upcoming service projects:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <strong><%= project.title %></strong>
                </a>
                — Organized by: 
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
                (<%= new Date(project.project_date).toLocaleDateString() %>)
            </li>
        <% }); %>
    </ul>

    <!-- PLAIN ENGLISH: A link that sends the user to the blank form for creating a brand new service project. -->
    <!-- LOGIC: A plain anchor tag pointing at the /new-project GET route. -->
    <!-- WHY WE NEED IT: Gives users a way to reach the create-project form directly from the main list page. -->
    <!-- LEARNING GAP: Unlike the project and organization links above, this one has no dynamic ID -- it always points to the same fixed URL. -->
    <%# PLAIN ENGLISH: Show the "Add a New Service Project" link only to admins.
        LOGIC: user comes from res.locals.user (set in server.js). If someone is logged in
               AND their role_name is 'admin', the link is shown. Otherwise it is left out.
        WHY WE NEED IT: Only admins can create a new service project, so regular users and visitors
                        shouldn't see a link that would just send them away with an error.
        LEARNING GAP: This only hides the link. The real protection is the admin lock on the
                      route in routes.js. "user &&" comes first because user is null when
                      nobody is logged in, and reading role_name from null would crash the page. %>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-project">Add a New Service Project</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
