<%- include('partials/header') %>

<%
/*
====================================================================
FILE: src/views/category.ejs
PURPOSE:
Display view for an individual category, showing its name and all 
associated service projects.

PLAIN ENGLISH:
This page displays the name of the chosen category as the main header.
Beneath it, it lists all volunteer service projects tagged under this 
genre, with clickable links to the project details and the host group.

LOGIC:
Reads the 'category' object for the header. Evaluates if the 'projects' 
array has items: if true, iterates using forEach to output list items; 
otherwise, falls back to a friendly 'no projects found' message.

WHY WE NEED IT:
Serves as the dedicated landing page when users click any category link 
or category tag across the site (/category/:id).

LEARNING GAP:
Checking array length with an if/else block prevents rendering empty, 
unstyled <ul> tags that fail accessibility guidelines.
====================================================================
*/
%>

<main>
    <h1><%= category.name %></h1>

    <p>Service projects under this category:</p>

    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                    </a>
                    — Organized by: 
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                    (<%= new Date(project.project_date).toLocaleDateString() %>)
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects currently found for this category.</p>
    <% } %>

    <!-- PLAIN ENGLISH: A link that opens the edit form for this category, already filled in with its current name. -->
    <!-- LOGIC: A plain anchor tag pointing at this category's edit page, using its own ID. -->
    <!-- WHY WE NEED IT: Lets users reach the edit form by clicking, instead of typing the address. -->
    <!-- LEARNING GAP: Clicking this link only SHOWS the form (GET) -- nothing changes until the user clicks Update Category, which sends POST. -->
    <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
</main>

<%- include('partials/footer') %>
