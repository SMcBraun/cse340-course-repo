<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <!-- PLAIN ENGLISH: Collects a new project's details, plus a dropdown to pick which organization hosts it. -->
    <!-- LOGIC: The dropdown loops through the organizations array, creating one option per organization. -->
    <!-- WHY WE NEED IT: Every project must be linked to an existing organization by its ID (a foreign key). -->
    <!-- LEARNING GAP: A <select> element only submits the chosen option's value attribute, not its visible text. -->
    <form action="/new-project" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                required
            ></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                required
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>"><%= org.name %></option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Create Project</button>
    </form>
</main>
<%- include('partials/footer') %>
