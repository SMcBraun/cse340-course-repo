<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization=> { %>
                <li>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.name %>
                    </a>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>

        <!-- PLAIN ENGLISH: A link that opens the blank form for adding a brand new partner organization. -->
        <!-- LOGIC: A plain anchor tag pointing at the New Organization page. -->
        <!-- WHY WE NEED IT: Lets users reach the create-organization form by clicking, instead of typing the address. -->
        <!-- LEARNING GAP: Same pattern as the Projects and Categories pages -- a list page offers a way to add to that list, so the site feels consistent. -->
        <p><a href="/new-organization">Add a New Organization</a></p>
    </main>
    <%- include('partials/footer') %>
