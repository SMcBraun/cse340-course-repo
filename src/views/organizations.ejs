<!-- Embeds the shared navigation header -->
<%- include('partials/header') %>

    <main>
        <!-- Displays the title sent from server.js -->
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>

        <ul>
            <!-- Loops through every organization row from the database -->
            <% organizations.forEach(organization=> { %>
                <li>
                    <!-- Dynamically inserts the image filename from PostgreSQL -->
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

                    <!-- Displays the organization name in bold and the contact email -->
                    <strong>
                        <%= organization.name %>
                    </strong>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>
    </main>

    <!-- Embeds the shared footer -->
    <%- include('partials/footer') %>