<%- include('partials/header') %>

<%
/*
====================================================================
FILE: src/views/project.ejs
PURPOSE:
Granular detail view for an individual service project, including host 
organization and clickable category tags.

PLAIN ENGLISH:
Displays the full details of a single event (title, date, location, description), 
a link back to the host charity, and clickable category tags at the bottom.

LOGIC:
Renders the individual 'project' object properties. Iterates over the 'categories' 
array to render dynamic tag links pointing to /category/:category_id.

WHY WE NEED IT:
Completes the multi-directional navigation loop across Projects, Organizations, 
and Categories required for 100% Mastery.

LEARNING GAP:
Rendering tags allows lateral discovery: a user reading about a garden project 
can click the [Environmental] tag to discover all other environmental projects.
====================================================================
*/
%>

<main>
    <h1><%= project.title %></h1>

    <p>
        <strong>Organization:</strong> 
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <strong>Date:</strong> 
        <%= new Date(project.project_date).toLocaleDateString() %>
    </p>

    <p>
        <strong>Location:</strong> 
        <%= project.location %>
    </p>

    <p>
        <strong>Description:</strong> 
        <%= project.description %>
    </p>

    <section class="project-categories">
        <strong>Categories:</strong>
        <% if (categories && categories.length > 0) { %>
            <ul style="display: inline-block; padding-left: 10px; list-style: none;">
                <% categories.forEach(category => { %>
                    <li style="display: inline; margin-right: 8px;">
                        <a href="/category/<%= category.category_id %>">
                            [<%= category.name %>]
                        </a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <span>None</span>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>