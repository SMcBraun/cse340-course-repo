<%- include('partials/header') %>

<%
/*
====================================================================
FILE: src/views/categories.ejs
PURPOSE:
Master list view displaying all available volunteer service categories.

PLAIN ENGLISH:
Displays the complete directory of categories. Each category's name is 
rendered as an active link that takes the user directly to that category's 
dedicated projects page.

LOGIC:
Loops through the 'categories' array passed from the controller and wraps 
each category's name inside an anchor tag pointing to /category/:category_id.

WHY WE NEED IT:
Satisfies Rubric Criterion 1: 'Pages list all items in the database and 
each one is a link to the details page of that item.'

LEARNING GAP:
Using primary keys in the href (/category/:id) binds our front-end 
navigation dynamically to relational database IDs.
====================================================================
*/
%>

<main>
    <h1><%= title %></h1>

    <p>Select a category to browse related service projects:</p>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </li>
        <% }); %>
    </ul>

    <!-- PLAIN ENGLISH: A link that opens the blank form for adding a brand new category. -->
    <!-- LOGIC: A plain anchor tag pointing at the New Category page. -->
    <!-- WHY WE NEED IT: Lets users reach the create-category form by clicking, instead of typing the address. -->
    <!-- LEARNING GAP: Same pattern as the "Add a New Service Project" link on the projects page -- a list page offers a way to add to that list. -->
    <%# PLAIN ENGLISH: Show the "Add a New Category" link only to admins.
        LOGIC: user comes from res.locals.user (set in server.js). If someone is logged in
               AND their role_name is 'admin', the link is shown. Otherwise it is left out.
        WHY WE NEED IT: Only admins can create a new category, so regular users and visitors
                        shouldn't see a link that would just send them away with an error.
        LEARNING GAP: This only hides the link. The real protection is the admin lock on the
                      route in routes.js. "user &&" comes first because user is null when
                      nobody is logged in, and reading role_name from null would crash the page. %>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-category">Add a New Category</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
